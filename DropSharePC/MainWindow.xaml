<Window x:Class="DropShare.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropShare PC - Yerel Ağ Dosya ve Metin Paylaşımı" Height="720" Width="1050"
        MinHeight="650" MinWidth="900"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource CardDark}" CornerRadius="16,16,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="DropShare PC" Foreground="{StaticResource TextWhite}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="─" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" FontSize="16" Width="30" Click="Minimize_Click" Cursor="Hand" Margin="0,0,4,0"/>
                    <Button Content="☐" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" FontSize="14" Width="30" Click="Maximize_Click" Cursor="Hand" Margin="0,0,4,0"/>
                    <Button Content="✕" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" FontSize="16" Width="30" Click="Close_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border Grid.Row="1" Background="{StaticResource BgDark}" CornerRadius="0,0,16,16" Padding="20,10,20,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Header Panel -->
                <Border Grid.Row="0" Background="{StaticResource CardDark}" CornerRadius="16" Padding="20" Margin="0,0,0,16" BorderBrush="{StaticResource CardLight}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀 DropShare PC" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextWhite}"/>
                                <Border Background="{StaticResource PrimaryCyan}" CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v1.0 LAN" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="{StaticResource CardLight}" CornerRadius="6" Padding="6,2" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding IpAdresiMetni}" Foreground="{StaticResource AccentTeal}" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <TextBlock Text="{Binding PcCihazAdi}" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding OtomatikKabul}" Content="Gelen Dosyaları Otomatik Kabul Et" Foreground="{StaticResource TextWhite}" FontSize="13" VerticalAlignment="Center" Margin="0,0,20,0">
                                <CheckBox.Resources>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="Foreground" Value="{StaticResource TextWhite}"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </CheckBox.Resources>
                            </CheckBox>
                            <Button Content="🔄 Ağı Tara" Background="{StaticResource CardLight}" Foreground="{StaticResource TextWhite}" Padding="14,10" BorderThickness="0" FontSize="13" FontWeight="SemiBold" Click="BtnAgiTara_Click" Margin="0,0,10,0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                                </Button.Resources>
                                <Button.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                                </Button.Effect>
                            </Button>
                            <Button Content="📁 İndirilenler" Background="{StaticResource PrimaryCyan}" Foreground="{StaticResource TextWhite}" Padding="14,10" BorderThickness="0" FontSize="13" FontWeight="Bold" Click="BtnKlasoruAc_Click" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                                </Button.Resources>
                                <Button.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                                </Button.Effect>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Workspace -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Discovered Devices Sidebar -->
                    <Border Grid.Column="0" Background="{StaticResource CardDark}" CornerRadius="16" Padding="16" Margin="0,0,16,0" BorderBrush="{StaticResource CardLight}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="📱 Bulunan Cihazlar" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextWhite}"/>
                                <Border Background="{StaticResource PrimaryCyan}" CornerRadius="10" Padding="6,1" HorizontalAlignment="Right" MinWidth="24">
                                    <TextBlock Text="{Binding Cihazlar.Count}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <ListBox Grid.Row="1" ItemsSource="{Binding Cihazlar}" SelectedItem="{Binding SecilenCihaz, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardLight}" CornerRadius="12" Padding="14" Margin="0,0,0,10" Cursor="Hand">
                                            <Border.Resources>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryCyan}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Resources>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Background="{StaticResource PrimaryCyan}" CornerRadius="20" Width="40" Height="40" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding CihazSimgesi}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CihazAdi}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <Border Background="{StaticResource BgDark}" CornerRadius="4" Padding="4,1">
                                                            <TextBlock Text="{Binding IpAdresi}" Foreground="#14B8A6" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Text=" • " Foreground="#94A3B8"/>
                                                        <TextBlock Text="{Binding TurMetni}" Foreground="#94A3B8" FontSize="11"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Manual IP Section -->
                            <Border Grid.Row="2" Background="{StaticResource CardLight}" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="🔑 Telefondaki IP İle Eşleştir" Foreground="{StaticResource AccentTeal}" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Mobil 'Eşleştir' sekmesindeki IP'yi girin:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ManuelIp, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Background="{StaticResource BgDark}" Foreground="{StaticResource TextWhite}" Padding="8" BorderThickness="1" FontSize="12" VerticalAlignment="Center">
                                            <TextBox.BorderBrush>
                                                <SolidColorBrush Color="#2A2A3A"/>
                                            </TextBox.BorderBrush>
                                            <TextBox.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                        <Button Grid.Column="1" Content="Bağlan" Background="{StaticResource AccentTeal}" Foreground="{StaticResource TextWhite}" Padding="12,6" Margin="8,0,0,0" BorderThickness="0" FontWeight="Bold" Click="BtnManuelIpEkle_Click" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                            <Button.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                                            </Button.Effect>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Main Content Area -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Target Status Banner -->
                        <Border Grid.Row="0" Background="{StaticResource CardDark}" CornerRadius="12" Padding="14,10" Margin="0,0,0,10" BorderBrush="{StaticResource CardLight}" BorderThickness="1">
                            <TextBlock Text="{Binding SecilenCihazMetni}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentTeal}"/>
                        </Border>

                        <!-- Drag & Drop Zone -->
                        <Border Grid.Row="1" x:Name="DropZone" Background="{StaticResource CardDark}" CornerRadius="16" BorderBrush="{StaticResource PrimaryCyan}" BorderThickness="2" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" Padding="20" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.2"/>
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}"/>
                                            <Setter Property="Background" Value="{StaticResource CardLight}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="DropIcon" Text="📁" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DropTitle" Text="Dosyaları Buraya Sürükleyip Bırakın" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextWhite}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="DropSubtitle" Text="Android telefonunuza veya tabletinize anında yüksek hızda gönderin" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                                <Button Content="📄 Bilgisayardan Dosya Seç" Background="{StaticResource PrimaryCyan}" Foreground="{StaticResource TextWhite}" FontSize="13" FontWeight="Bold" Padding="20,10" BorderThickness="0" Click="BtnDosyaSec_Click" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                                    </Button.Effect>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Transfer Progress Bar -->
                        <Border Grid.Row="2" Background="{StaticResource CardDark}" CornerRadius="16" Padding="16" Margin="0,10,0,10" BorderBrush="{StaticResource CardLight}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding AktarimDurumMetni}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextWhite}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AktarimHizMetni}" FontSize="12" Foreground="{StaticResource AccentTeal}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Value="{Binding AktarimYuzde}" Height="10" Margin="0,8,0,0" Background="{StaticResource CardLight}" Foreground="{StaticResource PrimaryCyan}">
                                    <ProgressBar.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </ProgressBar.Resources>
                                </ProgressBar>
                            </StackPanel>
                        </Border>

                        <!-- Text / Clipboard Share Box & Transfer History Tabs -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Text / Clipboard Box -->
                            <Border Grid.Column="0" Background="{StaticResource CardDark}" CornerRadius="16" Padding="12" Margin="0,0,8,0" BorderBrush="{StaticResource CardLight}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="📋 Metin veya Bağlantı Gönder" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextWhite}" Margin="0,0,0,6"/>
                                    <TextBox Grid.Row="1" Text="{Binding GonderilecekMetin, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Background="{StaticResource CardLight}" Foreground="{StaticResource TextWhite}" Padding="8" BorderThickness="1" FontSize="12" MinHeight="60" MaxHeight="80" VerticalScrollBarVisibility="Auto">
                                        <TextBox.BorderBrush>
                                            <SolidColorBrush Color="#2A2A3A"/>
                                        </TextBox.BorderBrush>
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                    <Button Grid.Row="2" Content="📤 Panodan Gönder" Background="{StaticResource AccentTeal}" Foreground="{StaticResource TextWhite}" Padding="12,8" Margin="0,8,0,0" BorderThickness="0" FontWeight="Bold" Click="BtnMetinGonder_Click" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                        </Button.Resources>
                                        <Button.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                                        </Button.Effect>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- History Log -->
                            <Border Grid.Column="1" Background="{StaticResource CardDark}" CornerRadius="16" Padding="12" Margin="8,0,0,0" BorderBrush="{StaticResource CardLight}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="📜 Son Aktarım Geçmişi" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextWhite}" Margin="0,0,0,6"/>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding Gecmis}" Background="Transparent" BorderThickness="0" MaxHeight="100">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource CardLight}" CornerRadius="8" Padding="8" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding YonSimgesi}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DosyaAdi}" FontWeight="Bold" Foreground="{StaticResource TextWhite}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding BoyutMetni}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding DurumSimgesi}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
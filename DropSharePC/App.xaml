<Application x:Class="DropShare.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Modern Dark Cyan/Teal Palette -->
            <SolidColorBrush x:Key="BgDark" Color="#0F172A" />
            <SolidColorBrush x:Key="CardDark" Color="#1E293B" />
            <SolidColorBrush x:Key="CardLight" Color="#334155" />
            <SolidColorBrush x:Key="PrimaryCyan" Color="#0EA5E9" />
            <SolidColorBrush x:Key="AccentTeal" Color="#14B8A6" />
            <SolidColorBrush x:Key="TextWhite" Color="#F8FAFC" />
            <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
